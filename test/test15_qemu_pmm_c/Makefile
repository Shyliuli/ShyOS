SHYOS_ROOT ?= $(abspath ../..)
SHYOS_CONFIG ?= $(CURDIR)/shyos.mk
TEST_NAME := test15_qemu_pmm_c
TEST_LANGUAGE := c

include ../image.mk

# NONE provider 下 malloc_page/free_page 不可见：编译必须失败
run: check-none-compile

.PHONY: check-none-compile
check-none-compile:
	@if $(CC) $(CFLAGS_COMMON) $(C_BUILD_FLAGS) -DSHYOS_PMM_NONE $(INCLUDES) \
		-Werror=implicit-function-declaration \
		-c none_compile_check.c -o /dev/null 2>/dev/null; then \
		echo "FAIL: malloc_page visible under SHYOS_PMM_NONE"; \
		exit 1; \
	else \
		echo "PASS: malloc_page hidden under SHYOS_PMM_NONE"; \
	fi
