SHYOS_ROOT ?= $(abspath ../..)
include $(SHYOS_ROOT)/mk/config.mk

LAYER := 03basic
OUT_DIR := target

SIMPLE_ALLOC_DIR := simple_alloc
SIMPLE_ALLOC_C_OBJ := $(SIMPLE_ALLOC_DIR)/target/simple_alloc_c.o

OBJ_DIR := obj
OBJ_C_OBJ := $(OBJ_DIR)/target/obj_c.o

LAYER_ARCHIVE := $(OUT_DIR)/libshyos_$(LAYER).a
LAYER_RUST_LIB := shyos_03basic_rust

ifeq ($(filter SHYOS_ALLOCATOR_SIMPLE,$(SHYOS_DEFINES)),)
LAYER_OBJS :=
else
LAYER_OBJS := $(SIMPLE_ALLOC_C_OBJ)
endif
LAYER_OBJS += $(OBJ_C_OBJ)

.PHONY: clean

$(OUT_DIR):
	mkdir -p $@

# basic_alloc_anchor.c 仅用于编译检查 allocator 公共 C 接口，不参与归档。
$(OUT_DIR)/.alloc-anchor: basic_alloc_anchor.c \
		$(SHYOS_ROOT)/lib/alloc/alloc.h $(SHYOS_CONFIG_STATE) | $(OUT_DIR)
	$(CC) $(CFLAGS) -fsyntax-only basic_alloc_anchor.c
	touch $@

$(LAYER_ARCHIVE): $(LAYER_OBJS) $(OUT_DIR)/.alloc-anchor $(SHYOS_CONFIG_STATE) | $(OUT_DIR)
	rm -f $@
	$(AR) rcs $@ $(LAYER_OBJS)

clean:
	rm -rf $(OUT_DIR)
	$(MAKE) -C $(SIMPLE_ALLOC_DIR) clean
	$(MAKE) -C $(OBJ_DIR) clean

include $(SHYOS_ROOT)/mk/layer.mk
