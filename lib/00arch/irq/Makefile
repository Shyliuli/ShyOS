# IRQ backend 由集中配置选择；linux_user 保持无硬件语义的稳定 ABI。

SHYOS_ROOT ?= $(abspath ../../..)
include $(SHYOS_ROOT)/mk/config.mk

OUT_DIR := $(SHYOS_TARGET_DIR)/$(BACKEND)
IRQ_C_OBJ := $(OUT_DIR)/irq_c.o

ifeq ($(BACKEND),qemu_virt)
IRQ_SRC := irq_qemu_virt.c
IRQ_DEPS := \
	$(SHYOS_ROOT)/lib/board/board.h \
	$(SHYOS_ROOT)/lib/board/qemu_virt/qemu.h
else ifeq ($(BACKEND),linux_user)
IRQ_SRC := irq_linux_user.c
IRQ_DEPS := \
	$(SHYOS_ROOT)/lib/00arch/linux_user_signal/linux_user_signal.h
else
$(error 00arch/irq has no $(BACKEND) backend)
endif

.PHONY: build clean

build: $(IRQ_C_OBJ)

$(OUT_DIR):
	mkdir -p $@

$(IRQ_C_OBJ): $(IRQ_SRC) irq.h $(IRQ_DEPS) $(SHYOS_CONFIG_STATE) | $(OUT_DIR)
	$(CC) $(CFLAGS) -c -o $@ $(IRQ_SRC)

clean:
	rm -rf target
