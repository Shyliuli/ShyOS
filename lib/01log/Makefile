# 01log 层：始终存在的 early console、可选 stdio provider 与 panic。

SHYOS_ROOT ?= $(abspath ../..)
include $(SHYOS_ROOT)/mk/config.mk

LAYER := 01log
OUT_DIR := target

PRINT_DIR := print
STDIO_EARLY_DIR := stdio_early
PANIC_DIR := panic
PRINT_C_OBJ := $(PRINT_DIR)/target/print_c.o
STDIO_EARLY_C_OBJ := $(STDIO_EARLY_DIR)/target/stdio_early_c.o
PANIC_C_OBJ := $(PANIC_DIR)/target/panic_c.o

LAYER_ARCHIVE := $(OUT_DIR)/libshyos_$(LAYER).a
LAYER_RUST_LIB := shyos_01log_rust
LAYER_OBJS := $(PRINT_C_OBJ) $(PANIC_C_OBJ)
ifneq ($(filter SHYOS_STDIO_EARLY,$(SHYOS_DEFINES)),)
LAYER_OBJS += $(STDIO_EARLY_C_OBJ)
endif

.PHONY: clean

$(OUT_DIR):
	mkdir -p $@

$(LAYER_ARCHIVE): $(LAYER_OBJS) $(SHYOS_CONFIG_STATE) | $(OUT_DIR)
	rm -f $@
	$(AR) rcs $@ $(LAYER_OBJS)

clean:
	rm -rf $(OUT_DIR)
	$(MAKE) -C $(PRINT_DIR) clean
	$(MAKE) -C $(STDIO_EARLY_DIR) clean
	$(MAKE) -C $(PANIC_DIR) clean

include $(SHYOS_ROOT)/mk/layer.mk
