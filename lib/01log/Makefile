include $(SHYOS_ROOT)/mk/config.mk

LAYER := 01log
OUT_DIR := $(SHYOS_TARGET_DIR)

PRINT_DIR := print
PANIC_DIR := panic
PRINT_C_OBJ := $(PRINT_DIR)/$(SHYOS_TARGET_DIR)/print_c.o
PANIC_C_OBJ := $(PANIC_DIR)/$(SHYOS_TARGET_DIR)/panic_c.o

LAYER_ARCHIVE := $(OUT_DIR)/libshyos_$(LAYER).a
LAYER_RUST_LIB := shyos_01log_rust
LAYER_OBJS := $(PRINT_C_OBJ) $(PANIC_C_OBJ)

.PHONY: clean

$(OUT_DIR):
	mkdir -p $@

# Makefile 自身作为 prerequisite：修改归档成员时必须重新归档。
$(LAYER_ARCHIVE): $(LAYER_OBJS) $(SHYOS_CONFIG_STATE) Makefile | $(OUT_DIR)
	rm -f $@
	$(AR) rcs $@ $(LAYER_OBJS)

clean:
	rm -rf target
	$(MAKE) -C $(PRINT_DIR) clean
	$(MAKE) -C $(PANIC_DIR) clean

include $(SHYOS_ROOT)/mk/layer.mk
